DATABASE_URL="postgresql://ingles:confianza@localhost:5432/ingles_con_confianza?schema=public"
GOOGLE_TTS_API_KEY=

# Belt-and-braces guard on /admin and /api/admin (see docs/engineering/deploy.md).
# Unset (as below): the guard is OFF and local dev needs no setup. Set it to
# require a matching `icc_admin` cookie for every admin request; run
# `npm run admin:secret` to generate a value.
ADMIN_SECRET=

# Optional: a Google Apps Script Web App URL that receives per-slide feedback
# POSTs (see docs/engineering/feedback.md for the 5-step Sheet setup). Unset:
# feedback is appended locally to data/feedback.jsonl instead.
FEEDBACK_WEBHOOK_URL=
