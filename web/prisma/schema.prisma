generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Declaration order = priority order (P1 highest). `ORDER BY curriculum_role`
// relies on it. New rows default to Unranked and are promoted by hand.
enum CurriculumRole {
  P1
  P2
  P3
  P4
  P5
  Unranked
  Trash
}

model CurriculumConcept {
  id             String              @id @db.Text
  spanish        String              @db.Text
  english        String              @db.Text
  exampleSpanish String              @map("example_spanish") @db.Text
  exampleEnglish String              @map("example_english") @db.Text
  curriculumRole CurriculumRole      @default(Unranked) @map("curriculum_role")
  sortOrder      Int                 @unique @map("sort_order")
  collections    ConceptCollection[]

  @@unique([spanish, english])
  @@map("curriculum_concepts")
}

model Collection {
  name               String              @id @db.Text
  conceptMemberships ConceptCollection[]

  @@map("collections")
}

model ConceptCollection {
  conceptId      String            @map("concept_id") @db.Text
  collectionName String            @map("collection_name") @db.Text
  position       Int
  concept        CurriculumConcept @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  collection     Collection        @relation(fields: [collectionName], references: [name], onDelete: Cascade)

  @@id([conceptId, collectionName])
  @@unique([conceptId, position])
  @@map("concept_collections")
}

model MappingSourceDocument {
  path       String               @id @db.Text
  pillar     String               @default("mappings") @db.Text
  direction  String               @db.Text
  hub        String               @db.Text
  kind       String               @db.Text
  extension  String               @db.Text
  content    String               @db.Text
  sha256     String               @db.VarChar(64)
  byteLength Int                  @map("byte_length")
  lineCount  Int                  @map("line_count")
  tags       String[]
  capturedAt DateTime             @map("captured_at") @db.Date
  sortOrder  Int                  @unique @map("sort_order")
  entries    MappingSourceEntry[]

  @@index([direction, hub])
  @@index([pillar])
  @@index([sha256])
  @@map("mapping_source_documents")
}

model MappingSourceEntry {
  id           String                @id @db.Text
  documentPath String                @map("document_path") @db.Text
  position     Int
  lineNumber   Int                   @map("line_number")
  section      String                @db.Text
  rawText      String                @map("raw_text") @db.Text
  cells        Json
  spanish      String?               @db.Text
  english      String?               @db.Text
  tags         String[]
  document     MappingSourceDocument @relation(fields: [documentPath], references: [path], onDelete: Cascade)

  @@unique([documentPath, position])
  @@index([documentPath])
  @@map("mapping_source_entries")
}
