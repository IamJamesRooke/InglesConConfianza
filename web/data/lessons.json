    {
      "id": "lesson_2a098380-a025-4d1a-a5a7-9adfd3ca08a5",
      "name": "I want to do something.",
      "blocks": [
        {
          "id": "block_3b5bef78-634a-4168-9db6-d833712108ab",
          "type": "explanation",
          "contentMarkdown": "==Yo== es ==I==.\n\n==I== se pronuncia **AI**: una sílaba.\n\n**AI.**"
        },
        {
          "id": "block_d92f439b-82e1-4ec9-bb76-b2a410b7df51",
          "type": "sentence",
          "promptLabel": "",
          "promptText": "",
          "helperText": "",
          "answerFeedback": "==Bien==.... ==Well==.\n\n==Hecho==... ==Done==.\n\n¡Bien hecho! Well done!",
          "conceptLinks": [],
          "languageBlocks": [
            {
              "id": "lang_213f23e1-e4f2-46d8-b891-80de21fc57e3",
              "spanish": "yo",
              "callout": null,
              "acceptedAnswers": [
                "I"
              ],
              "conceptLinks": []
            }
          ]
        },
        {
          "id": "block_6341d545-a474-4f25-a771-6bcabdc0d879",
          "type": "explanation",
          "contentMarkdown": "==Quiero== o ==yo quiero== es ==I want==.\n\nEn Norteamérica se pronuncia **AI WAHNT**.\n\n**AI WAHNT.**"
        },
        {
          "id": "block_34c88335-797e-4c5d-afc2-d4d4ee5390e6",
          "type": "sentence",
          "promptLabel": "",
          "promptText": "",
          "helperText": "Una palabra en español, dos palabras en inglés.",
          "answerFeedback": null,
          "conceptLinks": [],
          "languageBlocks": [
            {
              "id": "lang_faadc7ae-968e-4c10-bcc3-214d7a1cfd0b",
              "spanish": "quiero",
              "callout": null,
              "acceptedAnswers": [
                "I want"
              ],
              "conceptLinks": []
            }
          ]
        },
        {
          "id": "block_43116d7f-45b2-4e0d-96d6-05ff52686074",
          "type": "explanation",
          "contentMarkdown": "==Algo== es ==something==.\n\nEn Norteamérica se pronuncia **SUM-thing**: dos sílabas.\n\n**SUM-thing.**"
        },
        {
          "id": "block_952923de-27bd-4f99-87db-36d488329af6",
          "type": "sentence",
          "promptLabel": "",
          "promptText": "",
          "helperText": "",
