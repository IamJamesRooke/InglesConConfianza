{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "prisma generate",
    "build": "next build",
    "start": "next start",
    "lint": "eslint && npm run lint:css",
    "lint:css": "node scripts/lint-css.mjs",
    "lint:dead": "knip",
    "postinstall": "prisma generate",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:verify": "tsx scripts/verify-curriculum-database.ts",
    "db:test": "tsx --test tests/*.test.ts",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "ux:check": "playwright test",
    "ux:check:headed": "playwright test --headed",
    "db:studio": "prisma studio",
    "curriculum:sources:inventory": "tsx scripts/inventory-curriculum-sources.ts",
    "curriculum:sources:query": "tsx scripts/query-curriculum-sources.ts",
    "curriculum:roles:apply": "tsx scripts/apply-role-manifest.ts",
    "curriculum:concepts:apply": "tsx scripts/apply-concept-manifest.ts",
    "curriculum:concepts:add": "tsx scripts/add-concepts.ts",
    "curriculum:concepts:untag": "tsx scripts/untag-concepts.ts",
    "curriculum:audit": "tsx scripts/topic-audit.ts",
    "curriculum:audit:verbs": "tsx scripts/audit-verb-conjugation.ts",
    "curriculum:audit:cognates": "tsx scripts/audit-cognates.ts",
    "curriculum:audit:phrasal-verbs": "tsx scripts/audit-phrasal-verbs.ts",
    "curriculum:audit:status": "tsx scripts/audit-status.ts",
    "curriculum:apply": "tsx scripts/apply-curriculum.ts",
    "curriculum:collections:apply": "tsx scripts/apply-collection-manifest.ts",
    "curriculum:snapshots:export": "tsx scripts/export-curriculum-snapshots.ts",
    "curriculum:inventory": "tsx scripts/curriculum-inventory.ts"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-bold": "3.31.3",
    "@tiptap/extension-document": "3.31.3",
    "@tiptap/extension-hard-break": "3.31.3",
    "@tiptap/extension-italic": "3.31.3",
    "@tiptap/extension-paragraph": "3.31.3",
    "@tiptap/extension-text": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "knip": "^6.35.1",
    "prisma": "^7.9.1",
    "shadcn": "^4.17.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  },
  "overrides": {
    "deepmerge-ts": "8.0.1",
